APP_PORT=3000

# Local Prisma connection example:
# 1. Start an SSH tunnel from your computer to the server PostgreSQL port.
# 2. Point DATABASE_URL to the local forwarded port.
SSH_TUNNEL_HOST=your-server-ip
SSH_TUNNEL_PORT=22
SSH_TUNNEL_USER=your-ssh-user
SSH_LOCAL_PORT=5432

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=recipe_scanner
DB_USER=recipe_user

DATABASE_URL="postgresql://recipe_user:your-url-encoded-password@127.0.0.1:5432/recipe_scanner?schema=public"
