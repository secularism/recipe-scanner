{
  "name": "recipe-scanner",
  "version": "0.1.0",
  "private": true,
  "description": "微信小程序 - 根据食材和调味料生成菜谱",
  "scripts": {
    "dev:mp-weixin": "cross-env UNI_PLATFORM=mp-weixin vue-cli-service uni-build --watch",
